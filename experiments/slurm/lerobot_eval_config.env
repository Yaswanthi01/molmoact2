# Shared evaluation defaults for the MolmoAct2 LeRobot eval scripts.
# Copy this file to a local override if needed, or edit it directly.

# Required runtime settings
DATASET=panda_drawer_ee_molmoact2_v3
CHECKPOINT=$REPO_ROOT/checkpoints/panda-ee-50k-milestones/step35000
NORM_TAG=panda_drawer_ee

# Optional runtime settings
POLICY_TYPE=molmoact2
VIDEO_BACKEND=pyav
DEVICE=cuda
SEED=6198
N_ACTION_STEPS=30
NUM_STEPS=
SEQ_LEN=
INFERENCE_ACTION_MODE=continuous
HF_CKPT=false
ENABLE_DEPTH_REASONING=false
ENABLE_INFERENCE_CUDA_GRAPH=true
EPISODE_FRAMES=
VERBOSE=false
RUN_REPORTS=true
EXPECTED_EPISODES=101

# Output location
EVALUATION_ROOT=$REPO_ROOT/evaluations/panda_drawer_ee_molmoact2_v3-eval
